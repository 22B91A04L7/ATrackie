{
  "manifest_version": 3,
  "name": "Application Tracker",
  "version": "1.0.0",
  "description": "An react extension that Track job applications directly from job websites.",
  "icons": {
    "16": "public/icons/at-16.png",
    "32": "public/icons/at-32.png",
    "48": "public/icons/at-48.png",
    "128": "public/icons/at-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "public/icons/at-16.png",
      "32": "public/icons/at-32.png"
    }
  },
  "externally_connectable": {
  "matches": [
    "https://atrackie.vercel.app/*"
  ]
},
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
     "https://atrackie-backend.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/content.css"]
    }
  ]
}
