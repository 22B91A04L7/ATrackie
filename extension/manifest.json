{
  "manifest_version": 3,
  "name": "Application Tracker",
  "version": "1.0.0",
  "description": "An react extension that Track job applications directly from job websites.",
  "action": {
    "default_popup": "index.html"
  },
  "externally_connectable": {
  "matches": [
    "https://atrackie.vercel.app/*"
  ]
},
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
     "https://atrackie-backend.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/content.css"]
    }
  ]
}
